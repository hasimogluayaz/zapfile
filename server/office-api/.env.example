# Domain that points (DNS A record) to this server.
API_DOMAIN=api.zapfile.xyz

# Sites allowed to call the API (browser CORS).
ALLOWED_ORIGINS=https://www.zapfile.xyz,https://zapfile.xyz
# Vercel preview deployments of this project.
ALLOWED_ORIGIN_REGEX=^https://zapfile-[a-z0-9-]+-hasimogluayazs-projects\.vercel\.app$

# Parallel conversions (about 400 MB RAM each). 1 for a 1 GB server, 2-3 for 2-4 GB.
CONCURRENCY=1
API_MEM_LIMIT=900m
MAX_MB=50
TIMEOUT_S=90
RATE_PER_MIN=30
